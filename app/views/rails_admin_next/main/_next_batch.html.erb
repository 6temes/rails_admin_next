<%# locals: (collection:, url_proc:, frame_prefix: "list_batch") -%>
<%# full_page? is the count-free test: next_page and last_page? would run a COUNT. %>
<% if collection.full_page? %>
  <% next_page = collection.current_page + 1 %>
  <% next_url = url_proc.call(next_page) %>
  <%= turbo_frame_tag "#{frame_prefix}_#{next_page}", src: next_url, loading: :lazy, class: "list-batch", data: {
        controller: "infinite-scroll",
        action: "turbo:before-fetch-request->infinite-scroll#started:self turbo:fetch-request-error->infinite-scroll#failed:self turbo:frame-missing->infinite-scroll#missing:self",
        infinite_scroll_error_value: t('admin.pagination.error'),
        infinite_scroll_retry_label_value: t('admin.pagination.retry')
      } do %>
    <div class="list-batch-status">
      <span class="list-batch-loading"><%= t('admin.loading') %></span>
      <span class="list-batch-error" role="status" data-infinite-scroll-target="error"></span>
      <%= link_to t('admin.pagination.load_more'), next_url, class: "list-batch-link btn btn-light", data: { infinite_scroll_target: "link", action: "infinite-scroll#load" } %>
    </div>
  <% end %>
<% elsif collection.current_page > 1 %>
  <p class="list-end"><%= t('admin.pagination.end') %></p>
<% end %>
