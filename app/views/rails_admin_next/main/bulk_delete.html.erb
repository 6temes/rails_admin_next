<% confirmation = @count ? t("admin.form.bulk_delete_count", name: pluralize(number_with_delimiter(@count), @model_config.label, plural: @model_config.label_plural)) : t("admin.form.bulk_delete") %>
<h4>
  <%= confirmation %>
</h4>
<% unless @count %>
  <ul>
    <%= render partial: "delete_notice", collection: @objects %>
  </ul>
<% end %>
<%# The selection travels in the body: a few hundred ids would overflow the URL. %>
<%= form_tag bulk_delete_path(model_name: @abstract_model.to_param, scope: params[:scope].presence), method: :delete do %>
  <% if @objects %>
    <% @objects.each do |object| %>
      <%= hidden_field_tag "bulk_ids[]", @abstract_model.format_id(object.id), id: nil %>
    <% end %>
  <% else %>
    <%= hidden_field_tag :all_matching, params[:all_matching], id: nil %>
    <% URI.decode_www_form(request.params.slice("query", "f", "sort", "sort_reverse").to_query).each do |name, value| %>
      <%= hidden_field_tag name, value, id: nil %>
    <% end %>
    <%= hidden_field_tag :expected_count, @count, id: nil %>
  <% end %>
  <div class="form-actions">
    <input name="return_to" type="<%= :hidden %>" value="<%= (params[:return_to].presence || request.referer) %>" />
    <button class="btn btn-danger" data-disable-with="<%= t("admin.form.confirmation") %>" data-turbo-confirm="<%= confirmation %>" type="submit">
      <%= rails_admin_icon(:check) %>
      <%= t("admin.form.confirmation") %>
    </button>
    <button class="btn" data-disable-with="<%= t("admin.form.cancel") %>" name="_continue" type="submit">
      <%= rails_admin_icon(:cancel) %>
      <%= t("admin.form.cancel") %>
    </button>
  </div>
<% end %>
