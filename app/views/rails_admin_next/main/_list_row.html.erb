<%# locals: (object:, properties:, checkboxes:) -%>
<%= tag.tr id: (dom_id(object, :row) if object.to_key.present?), class: "#{@abstract_model.param_key}_row #{@model_config.list.with(object: object).row_css_class}", data: { sidescroll_target: "row" } do %>
  <% if checkboxes %>
    <td class="sticky">
      <%= check_box_tag "bulk_ids[]", @abstract_model.format_id(object.id), false, data: ({bulk_selection_target: "row", action: "change->bulk-selection#rowChanged"} unless @model_config.list.numbered_pagination?) %>
    </td>
  <% end %>
  <% properties.map{ |property| property.bind(:object, object) }.each do |property| %>
    <% value = property.pretty_value %>
    <%= content_tag(:td, class: [property.sticky? && 'sticky', property.css_class, property.type_css_class].select(&:present?), title: strip_tags(value.to_s)) do %>
      <%= value %>
    <% end %>
  <% end %>
  <td class="last links ra-sidescroll-frozen">
    <ul class="nav d-inline list-inline">
      <%= menu_for :member, @abstract_model, object, true %>
    </ul>
  </td>
<% end %>
