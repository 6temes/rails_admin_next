<%
  query = params[:query]
  sort_reverse = ('true' if params[:sort_reverse] == 'true')
  sort = params[:sort]
  params = list_params
  export_action = RailsAdminNext::Config::Actions.find(:export, { controller: self.controller, abstract_model: @abstract_model })
  export_action = nil unless export_action && authorized?(export_action.authorization_key, @abstract_model)
  description = RailsAdminNext.config(@abstract_model.model_name).description
  properties = list_properties
  numbered = @model_config.list.numbered_pagination?
  checkboxes = @model_config.list.checkboxes?
  selectable = checkboxes && !numbered
  total_count = (@objects.respond_to?(:total_count) ? @objects.total_count.to_i : @objects.to_a.size) unless numbered || @model_config.list.limited_pagination
  table_table_header_count = begin
    count = checkboxes ? 1 : 0
    count = count + properties.count
  end
%>

<% content_for :contextual_tabs do %>
  <% if filterable_fields.present? %>
    <li class="nav-item dropdown">
      <button type="button" id="filters_toggle" class="nav-link dropdown-toggle" popovertarget="filters" data-controller="dropdown" data-action="keydown->dropdown#onKeydown">
        <%= t('admin.misc.add_filter') %>
        <b class="caret"></b>
      </button>
      <ul class="dropdown-menu dropdown-menu-end" id="filters" role="menu" popover="auto">
        <% filterable_fields.each do |field| %>
          <li role="none">
            <a
              href="#"
              class="dropdown-item"
              role="menuitem"
              tabindex="-1"
              data-options="<%= field.with(view: self).filter_options.to_json %>"
            >
              <%= field.label %>
            </a>
          </li>
        <% end %>
      </ul>
    </li>
  <% end %>
  <% if checkboxes && numbered %>
    <%= bulk_menu %>
  <% end %>
<% end %>

<style nonce="<%= content_security_policy_nonce %>">
  <% properties.select{ |p| p.column_width.present? }.each do |property| %>
    <%= "#list th.#{property.css_class} { width: #{property.column_width}px; min-width: #{property.column_width}px; }" %>
    <%= "#list td.#{property.css_class} { max-width: #{property.column_width}px;}" %>
  <% end %>
</style>

<div id="list">
  <%= form_tag(index_path(params.except(*%w[page f query])), method: :get) do %>
    <div class="card mb-3 p-3 bg-light">
      <div class="row" data-controller="filter-box" data-options="<%= ordered_filter_options.to_json %>" id="filters_box"></div>
      <hr class="filters_box"/>
      <div class="row">
        <div class="col-sm-6">
          <div class="input-group">
            <input class="form-control" name="query" placeholder="<%= t("admin.misc.filter") %>" type="search" value="<%= query %>" />
            <button class="btn btn-primary" data-disable-with="<%= RailsAdminNext::Icons.svg(:refresh) + t('admin.misc.refresh') %>" type="submit">
              <%= rails_admin_icon(:refresh) %>
              <%= t('admin.misc.refresh') %>
            </button>
            <button class="btn btn-info" id="remove_filter" title="<%= t('admin.misc.reset_filters') %>">
              <%= rails_admin_icon(:cancel) %>
            </button>
          </div>
          <% if @model_config.list.search_help.present? %>
            <div class="form-text"><%= @model_config.list.search_help %></div>
          <% end %>
        </div>
        <div class="col-sm-6 text-end">
          <% if export_action %>
            <%= link_to wording_for(:link, export_action), export_path(params.except('page')), class: 'btn btn-info' %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
  <% unless list_scopes.empty? %>
    <ul class="nav nav-tabs" id="scope_selector">
      <% list_scopes.each_with_index do |scope, index| %>
        <% scope = '_all' if scope.nil? %>
        <li class="nav-item">
          <a href="<%= index_path(params.merge(scope: scope, page: nil)) %>" class="nav-link <%= 'active' if scope.to_s == params[:scope] || (params[:scope].blank? && index == 0) %>">
            <%= I18n.t("admin.scopes.#{@abstract_model.to_param}.#{scope}", default: I18n.t("admin.scopes.#{scope}", default: scope.to_s.titleize)) %>
          </a>
        </li>
      <% end %>
    </ul>
  <% end %>
  <% if total_count %>
    <div class="total-count">
      <%= "#{number_with_delimiter(total_count)} #{@model_config.pluralize(total_count).downcase}" %>
    </div>
  <% end %>
  <%= form_tag bulk_action_path(model_name: @abstract_model.to_param), method: :post, id: "bulk_form", class: ["form", "mb-3"], data: ({controller: "bulk-selection", bulk_selection_selected_count_value: t("admin.misc.selected_count")} if selectable) do %>
    <%= hidden_field_tag :bulk_action %>
    <%= hidden_field_tag :scope, params[:scope] if params[:scope].present? %>
    <% if description.present? %>
      <p>
        <strong>
          <%= description %>
        </strong>
      </p>
    <% end %>
    <% if selectable %>
      <%= render "selection_bar", total_count:, offer: @objects.respond_to?(:full_page?) && @objects.full_page? %>
    <% end %>
    <div id="sidescroll" data-controller="sidescroll">
      <table class="table table-condensed table-striped table-hover">
        <thead>
          <tr>
            <% if checkboxes %>
              <th class="shrink sticky">
                <%= tag.input class: "toggle", type: "checkbox", data: ({bulk_selection_target: "header", action: "change->bulk-selection#toggleAll"} if selectable) %>
              </th>
            <% end %>
            <% properties.each do |property| %>
              <% selected = (sort == property.name.to_s) %>
              <% if property.sortable %>
                <% sort_location = index_path params.except('sort_reverse').except('page').merge(sort: property.name).merge(selected && sort_reverse != "true" ? {sort_reverse: "true"} : {}) %>
                <% sort_direction = (sort_reverse == 'true' ? "headerSortUp" : "headerSortDown" if selected) %>
              <% end %>
              <th class="<%= [property.sortable && "header", property.sortable && sort_direction, property.sticky? && 'sticky', property.css_class, property.type_css_class].select(&:present?).join(' ') %>" data-href="<%= property.sortable && sort_location %>" rel="tooltip" title="<%= property.hint %>">
                <%= property.label %>
              </th>
            <% end %>
            <th class="last shrink"></th>
          </tr>
        </thead>
        <tbody class="table-group-divider" id="list_rows">
          <% @objects.each do |object| %>
            <%= render 'list_row', object:, properties:, checkboxes: %>
          <% end %>
          <% if @objects.empty? %>
            <tr class="empty_row">
              <td colspan="<%= table_table_header_count %>">
                <%= I18n.t('admin.actions.index.no_records') %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if !numbered %>
      <%= render 'next_batch', collection: @objects, url_proc: method(:list_batch_url) if @objects.respond_to?(:full_page?) %>
    <% elsif @model_config.list.limited_pagination %>
      <div class="row">
        <div class="col-md-6">
          <%= render 'pagination', collection: @objects, mode: :limited, url_proc: ->(page) { index_path(params.except('page', :page).merge(page: page)) } %>
        </div>
      </div>
    <% elsif @objects.respond_to?(:total_count) %>
      <% total_count = @objects.total_count.to_i %>
      <div class="row">
        <div class="col-md-6">
          <%= render 'pagination', collection: @objects, mode: :numbered, url_proc: ->(page) { index_path(params.except('page', :page).merge(page: page)) } %>
        </div>
      </div>
      <div class="row">
        <div class="col-md-6">
          <%= link_to(t("admin.misc.show_all"), index_path(params.merge(all: true)), class: "show-all btn btn-light clearfix") unless total_count > 100 || total_count <= @objects.to_a.size %>
        </div>
      </div>
      <div class="clearfix total-count">
        <%= "#{total_count} #{@model_config.pluralize(total_count).downcase}" %>
      </div>
    <% else %>
      <div class="clearfix total-count">
        <%= "#{@objects.size} #{@model_config.pluralize(@objects.size).downcase}" %>
      </div>
    <% end %>
  <% end %>
</div>
